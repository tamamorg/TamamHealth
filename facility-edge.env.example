# TamamHealth facility-edge offline profile
#
# Copy to `.env.facility-edge`, replace every REPLACE value, and run:
#   docker compose --env-file .env.facility-edge \
#     -f docker-compose.yml -f docker-compose.facility-edge.yml up -d --build
#
# Devices must open FACILITY_APP_URL over the clinic LAN. Use a hostname whose
# TLS certificate is trusted by every managed device; service workers do not run
# on insecure non-localhost HTTP origins.

FACILITY_HOSTNAME=tamamhealth.clinic.example
FACILITY_APP_URL=https://tamamhealth.clinic.example
PLATFORM_PORT=3000
COUCHDB_PORT=5984

COUCHDB_USER=admin
COUCHDB_PASSWORD=REPLACE-with-a-long-random-couchdb-password
COUCHDB_WEBHOOK_SECRET=REPLACE-with-at-least-32-random-characters
COUCHDB_GATEWAY_SECRET=REPLACE-with-at-least-32-random-characters

NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_SYNC_ENABLED=true
NEXT_PUBLIC_COUCHDB_TENANT_DATABASES_ENABLED=true
NEXT_PUBLIC_COUCHDB_GATEWAY_ENABLED=true
NEXT_PUBLIC_COUCHDB_URL=https://tamamhealth.clinic.example/api/couch
NEXT_PUBLIC_APP_URL=https://tamamhealth.clinic.example
NEXT_PUBLIC_OFFLINE_DEPLOYMENT_MODE=facility-edge
NEXT_PUBLIC_OFFLINE_CACHE_PATIENT_ROUTES=true
NEXT_PUBLIC_OFFLINE_PATIENT_ROUTE_LIMIT=500
NEXT_PUBLIC_OFFLINE_REQUIRE_PERSISTENT_STORAGE=true
OFFLINE_GATEWAY_RELATIONSHIP_AUTHORIZATION=true

# This is an operator attestation: the edge host volume AND clinician device
# disks must actually be encrypted. The app refuses facility-edge boot without
# the declaration but cannot turn on BitLocker/FileVault/LUKS itself.
PHI_AT_REST_STRATEGY=disk-encryption
PHI_ENCRYPTION_ENABLED=false

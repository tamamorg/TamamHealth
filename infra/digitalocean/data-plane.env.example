# Copy to the production data host as /opt/tamamhealth/.env.data.
# Never commit the populated file.
COUCHDB_USER=REPLACE
COUCHDB_PASSWORD=REPLACE
COUCHDB_SECRET=REPLACE-with-a-separate-random-cookie-secret
COUCHDB_PORT=5984
COUCHDB_BIND_ADDRESS=127.0.0.1
COUCHDB_WEBHOOK_SECRET=REPLACE-with-the-same-64-character-secret-used-by-vercel
PLATFORM_SYNC_URL=https://tamamhealth-v6.vercel.app/api/sync
# Use the exact Git commit being deployed; never use "latest" or a mutable
# environment tag for PHI-bearing production services.
RELEASE_ID=REPLACE-git-commit-sha
BACKUP_RETAIN_DAYS=14
POLL_INTERVAL_MS=5000
BATCH_SIZE=100
REQUEST_TIMEOUT_MS=15000
CADDY_EMAIL=REPLACE-operations-email

# Copy to backend.hcl (gitignored) and fill in the dedicated private Spaces
# bucket. Supply the access/secret keys through AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY, never in this file.
bucket = "REPLACE-tamamhealth-terraform-state"
key    = "production/v7/terraform.tfstate"
region = "fra1"

endpoints = {
  s3 = "https://fra1.digitaloceanspaces.com"
}

use_path_style              = false
skip_credentials_validation = true
skip_region_validation      = true
skip_requesting_account_id  = true
skip_metadata_api_check     = true
skip_s3_checksum            = true

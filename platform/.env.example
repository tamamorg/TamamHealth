# =============================================================================
# TamamHealth Platform — Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# Or run the setup script which does this automatically:
#   npm run setup
# =============================================================================

# --- Mode ---
# "true"  = seeds demo patients, hospitals, users for testing (default)
# "false" = production mode — no demo data, creates single admin user
NEXT_PUBLIC_DEMO_MODE=true

# --- Screen lock ---
# Disables the auto screen-lock / inactivity PIN overlay. Useful for local
# development (the lock also fires on every tab/window switch via
# visibilitychange, which gets old fast while testing). This is a security
# feature for shared clinical devices — leave it "false"/unset in production
# and any real deployment.
# NEXT_PUBLIC_AUTO_LOCK_DISABLED=false

# --- Production Setup (only when DEMO_MODE=false) ---
# Initial admin display name (safe to expose to the browser).
NEXT_PUBLIC_ADMIN_NAME=System Administrator

# Initial admin password — server-only. NOT NEXT_PUBLIC_*: the browser must
# never see this. If you leave it unset, the platform generates a random
# admin password on first boot and writes it to .seed-credentials.json
# (see lib/seed-credentials.ts). Either way, change it the moment you log in.
# ADMIN_INITIAL_PASSWORD=

# Superadmin bootstrap password — server-only. Optional locally (the seeded
# account falls back to the well-known "Superadmin!"), but REQUIRED in
# production whenever sync is enabled: lib/config-validation.ts refuses to boot
# without it and rejects "Superadmin!", placeholders, and values under 16 chars.
# SUPERADMIN_INITIAL_PASSWORD=

# Organization details
NEXT_PUBLIC_ORG_NAME=My Organization
NEXT_PUBLIC_ORG_EMAIL=support.tamam@gmail.com
NEXT_PUBLIC_ORG_COUNTRY=South Sudan

# --- Auth ---
# JWT secret for session tokens. MUST be set to a strong random value.
# Generate a secure secret: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Or on Linux/macOS:        openssl rand -base64 48
#
# ALWAYS use the SERVER-ONLY JWT_SECRET below. Do NOT set NEXT_PUBLIC_JWT_SECRET
# in production — NEXT_PUBLIC_* values are inlined into the browser bundle, so a
# public JWT secret would let anyone forge tokens for any role. The app refuses
# to start in production if NEXT_PUBLIC_JWT_SECRET is set. It exists only as a
# last-resort fallback for the local offline dev-token path.
JWT_SECRET=change-me-to-a-random-secret
# NEXT_PUBLIC_JWT_SECRET=   # dev-only; never set in production

# --- PHI field encryption (application-level, at rest) ---
# Encrypts the most sensitive patient fields inside the document before it is
# written to CouchDB/PouchDB, so a stolen database file or an unauthorised
# CouchDB read does not yield readable patient identifiers.
#
# ON BY DEFAULT. This is patient health information in a jurisdiction where a
# leak can put people in physical danger; an operator who does nothing should
# get the safe behaviour, not the fast one. Turn it off only for a throwaway
# demo, and never on anything holding real patient data.
#
# Boot is fail-closed: with PHI_ENCRYPTION_ENABLED=true and a missing or
# wrong-length key the app refuses to start rather than silently writing
# plaintext PHI (see lib/config-validation.ts).
#
# Generate the key ONCE per deployment and escrow it alongside the CouchDB
# credentials:
#     openssl rand -base64 32
#
# WARNING: losing this key makes every encrypted field permanently unreadable.
# There is no recovery path. Back it up before you write any real data, and
# rotating it requires re-encrypting existing documents.
PHI_ENCRYPTION_ENABLED=true
PHI_ENCRYPTION_KEY=

# --- PostgreSQL (National Analytics Database) ---
# Server-side only — never exposed to the browser.
# Required for national-level analytics, government dashboards, and cross-facility reporting.
# If not set, the app still works fully via local PouchDB (browser IndexedDB).
DATABASE_URL=postgresql://tamamhealth:password@localhost:5432/safeguard_junub
# Direct endpoint for session-level migration locks when DATABASE_URL uses a
# transaction pool. In local development this may equal DATABASE_URL.
DATABASE_DIRECT_URL=postgresql://tamamhealth:password@localhost:5432/safeguard_junub
# Base64-encoded provider CA PEM for strict managed-database TLS verification.
# DATABASE_CA_CERT_BASE64=

# --- CouchDB Sync (Optional) ---
# Enable PouchDB <-> CouchDB live replication for multi-facility sync.
# When "false" the app works fully offline with local PouchDB only.
NEXT_PUBLIC_SYNC_ENABLED=false
NEXT_PUBLIC_COUCHDB_TENANT_DATABASES_ENABLED=false
NEXT_PUBLIC_COUCHDB_GATEWAY_ENABLED=false
# Required only while production still uses shared database names.
SINGLE_ORG_MODE=true

# CouchDB server URL (include credentials for authenticated access)
NEXT_PUBLIC_COUCHDB_URL=http://localhost:5984

# CouchDB admin credentials (used by setup script)
COUCHDB_ADMIN_USER=admin
COUCHDB_ADMIN_PASSWORD=TamamHealth4Lyf

# Organizations allowed to replicate the SHARED aggregate databases, as a
# comma-separated list of orgIds. Read by `npm run setup:couchdb:validators`
# when it writes each database's `_security.members.roles` — without a matching
# `org:<orgId>` role, CouchDB 3 answers every browser pull/push with 403.
# Per-organization tenant databases do not use this: they take their single
# owning org from the database name.
# Omitting it grants nothing and revokes nothing (existing members are kept, and
# the run says so). Set COUCHDB_REVOKE_UNLISTED_MEMBERS=true to actually lock
# the aggregates down — the intended state once tenant databases are live.
# COUCHDB_MEMBER_ORG_IDS=org-moh-ss,org-mercy-hospital
# COUCHDB_REVOKE_UNLISTED_MEMBERS=false

# CouchDB webhook signing secret — required if sync is enabled.
# Used to verify /api/sync webhook requests from CouchDB.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# COUCHDB_WEBHOOK_SECRET=

# --- Server-side CouchDB access (for /api/* routes) ---
# The platform API routes talk to CouchDB directly over the internal network.
# Separate from NEXT_PUBLIC_COUCHDB_URL (which is what the BROWSER hits).
# In docker-compose, this is http://couchdb:5984; in bare dev, http://localhost:5984.
# COUCHDB_URL=http://localhost:5984
# COUCHDB_ADMIN_USER=admin
# COUCHDB_ADMIN_PASSWORD=

# --- Email (Optional) ---
# For contact forms, demo requests, and notifications.
# EMAIL_PROVIDER picks the backend: "resend" | "sendgrid" | "smtp" | "" (disabled)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# FROM_EMAIL=support.tamam@gmail.com
# DEMO_FROM_EMAIL=support.tamam@gmail.com
# DEMO_FROM_NAME=TamamHealth
# DEMO_NOTIFY_EMAIL=support.tamam@gmail.com

# --- Payments (Optional) ---
# Webhook secrets for payment providers. When set, the matching webhook route
# verifies an HMAC-SHA256 signature on the raw body and rejects mismatches;
# when unset, signature verification is skipped (dev convenience).
# FLUTTERWAVE_SECRET_HASH=
MPESA_WEBHOOK_SECRET=REPLACE-with-mpesa-webhook-hmac-secret
# Daraja callbacks omit currency; callbacks are reconciled against this value.
MPESA_CURRENCY=KES
AIRTEL_WEBHOOK_SECRET=REPLACE-with-airtel-webhook-hmac-secret

# --- App URL ---
# Base URL for generating payment links and external URLs
# NEXT_PUBLIC_APP_URL=https://app.tamamhealth.org

# --- Localization defaults ---
# 3-letter ISO 4217 currency code used as the default for ledger entries and
# payment links when the caller doesn't supply one. Defaults to SSP.
# NEXT_PUBLIC_DEFAULT_CURRENCY=SSP

# Default 3-letter prefix used in patient hospital-number generation when a
# facility doesn't have its own `code` field and the ID doesn't match the
# `phcc-` / `phcu-` / `county-` structural patterns. Defaults to TAB.
# NEXT_PUBLIC_HOSPITAL_NUMBER_DEFAULT_PREFIX=TAB

# Login screen subtitle/footer overrides. Defaults derive from
# NEXT_PUBLIC_ORG_COUNTRY ("Republic of <country> · Ministry of Health · v2.0").
# NEXT_PUBLIC_LOGIN_FOOTER=

# --- FHIR namespace ---
# Base URI used for FHIR identifier.system fields (hospital number, geocode,
# national ID) and CodeSystem/ValueSet `url` fields emitted by /api/terminology.
# Should be a domain you own. Defaults to https://tamamhealth.org.
# NEXT_PUBLIC_FHIR_NAMESPACE_BASE=https://tamamhealth.org

# --- DHIS2 export (Optional) ---
# National health information system endpoint. The code reads
# NEXT_PUBLIC_DHIS2_BASE_URL (or DHIS2_BASE_URL on the server side); legacy
# `NEXT_PUBLIC_DHIS` is no longer recognized.
# NEXT_PUBLIC_DHIS2_BASE_URL=https://hmis.southsudan.health
# DHIS2_BASE_URL=https://hmis.southsudan.health      # server-side override
# DHIS2_USER=
# DHIS2_PASSWORD=
# DHIS2_PAT=

# --- Telehealth video (LiveKit) ---
# Real-time media for telehealth visits. Without these three set, the platform
# does NOT pretend to have video: /api/telehealth/token returns 503 and the
# visit room says video is unconfigured. That is deliberate — a telehealth
# screen that looks live but is not is worse than one that admits it is down.
#
# LIVEKIT_URL is the signalling endpoint of your LiveKit server (wss://).
# Self-hosted is the intended deployment: media never leaves infrastructure you
# control, which is what the af-south-1 / in-country residency position
# requires. A managed SFU would route PHI-bearing media through a third party.
#
# API key/secret are SERVER-ONLY — they sign join tokens. Anyone holding them
# can mint access to any consultation, so treat them like JWT_SECRET. Never set
# NEXT_PUBLIC_LIVEKIT_API_KEY / _SECRET: production refuses to boot if you do,
# because they would ship inside the browser bundle.
#
# Set all three or none. A partial configuration fails production boot rather
# than surfacing as a 503 the first time a clinician opens a consultation.
# In production LIVEKIT_URL must be wss:// — the media carries PHI.
# LIVEKIT_URL=wss://livekit.example.internal
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
#
# REQUIRED whenever the three above are set. The browser dials LiveKit
# directly, so its origin has to appear in the page's Content-Security-Policy —
# and that policy is built in middleware, where Next inlines env at BUILD time.
# The server-only LIVEKIT_URL is invisible there, so a deployment carrying only
# it builds a policy without LiveKit and every call is blocked in the browser.
# Production boot refuses that combination rather than shipping it.
# It is a URL, not a credential: unlike the key and secret, publishing it costs
# nothing. Docker builds pass it as a build arg (see platform/Dockerfile).
# NEXT_PUBLIC_LIVEKIT_URL=wss://livekit.example.internal
#
# LOCAL DEVELOPMENT: run the bundled LiveKit container instead of pointing at a
# real server, otherwise telehealth cannot be exercised at all on a dev machine.
#
#   docker compose -f ../docker-compose.livekit.yml up -d
#
# then put these three in .env.local (gitignored) and restart `npm run dev`:
#
#   LIVEKIT_URL=ws://localhost:7880
#   LIVEKIT_API_KEY=devkey
#   LIVEKIT_API_SECRET=secret
#
# Those are LiveKit's --dev placeholder credentials over plaintext ws://. They
# are for localhost only; the production checks above reject both.

# --- Fingerprint biometrics (Optional) ---
# Enables fingerprint enrollment + identification UI. Requires the
# fingerprint-bridge service running on the machine the scanner is plugged
# into (see fingerprint-bridge/README.md). Templates are stored in the
# tamamhealth_biometric_templates database and sync like other clinical data.
# NEXT_PUBLIC_FINGERPRINT_ENABLED=true
# NEXT_PUBLIC_FINGERPRINT_BRIDGE_URL=http://127.0.0.1:7345
# When the bridge requires a shared secret, set the SAME value here so the app
# sends it as the X-Bridge-Token header on capture/match:
# NEXT_PUBLIC_FINGERPRINT_BRIDGE_TOKEN=<random-secret>
# On the bridge host, pin the allowed app origin (defaults to localhost dev),
# and optionally require a shared secret on capture/match:
# FINGERPRINT_BRIDGE_ALLOWED_ORIGIN=https://app.tamamhealth.example
# FINGERPRINT_BRIDGE_TOKEN=<random-secret>   (must match NEXT_PUBLIC_FINGERPRINT_BRIDGE_TOKEN above)

# --- Observability / Sentry (Optional) ---
# When unset, Sentry init is a no-op everywhere (this is the dev default —
# you do NOT need a Sentry account to run the platform locally).
#
# SENTRY_DSN              — server-side DSN. Used by sentry.server.config.ts
#                           and sentry.edge.config.ts. NOT exposed to browser.
# NEXT_PUBLIC_SENTRY_DSN  — browser DSN. Baked into the client bundle at build
#                           time. Usually identical to SENTRY_DSN (one Sentry
#                           project covers both halves).
# SENTRY_RELEASE          — optional release identifier; tags every event.
#                           Defaults to NEXT_PUBLIC_BUILD_ID-style timestamp.
#
# See docs/operations/monitoring.md for the PII-stripping policy and the
# uptime / alerting setup.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_RELEASE=

# --- Shared security state (Upstash Redis) ---
# Rate-limit counters and the JWT revocation list live here. Without it both
# are PER-INSTANCE: an attacker gets the login limit once per replica, and a
# token revoked at logout on one replica keeps working on the others until it
# expires.
#
# REQUIRED in production. The app refuses to boot without it unless you set
# SINGLE_REPLICA_ACK=true to confirm this deploy runs exactly one platform
# replica (see lib/config-validation.ts). Demo deployments are exempt.
#
# Create a free database at https://console.upstash.com — copy the REST URL
# and REST token (not the redis:// connection string).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
#
# Set to "true" ONLY if you run a single platform container. On the default
# docker-compose stack that is the case.
# SINGLE_REPLICA_ACK=true

# --- Patient portal second factor (OTP over SMS) ---
# When "true", a correct portal password is NOT enough: the server SMSes a
# 6-digit code to the phone on the patient's record and only issues a session
# token once that code is verified.
#
# OFF by default on purpose. With no working SMS_PROVIDER below, turning this on
# would lock every patient out of their own records — worse than the risk it
# mitigates. Turn it on only after confirming SMS delivery works.
#
# Codes: 5-minute expiry, single-use, 5 wrong attempts burns the challenge.
# A patient with no phone number on file falls through to password-only rather
# than being permanently locked out.
# PATIENT_PORTAL_OTP_ENABLED=false

# SMS gateway used for OTP and patient messaging.
# "noop" (default) logs instead of sending — fine for dev, NOT for OTP.
# SMS_PROVIDER=noop            # noop | africastalking | twilio

# --- Patient reminder dispatch (KAN-104) ---
# Daily scheduled dispatch of due reminders lives in
# .github/workflows/reminders-cron.yml, which POSTs to
# /api/patient-reminders/dispatch. A scheduled job has no user session, so it
# authenticates with this shared secret instead. UNSET = no machine access at
# all (not open access).
#   openssl rand -hex 32
# REMINDER_DISPATCH_SECRET=
#
# Nothing is actually sent unless the gateway is switched on AND SMS_PROVIDER
# is configured — otherwise dispatch reports gatewayEnabled:false and the
# staff-worked queue is preserved.
# PATIENT_REMINDER_SMS_ENABLED=false

# --- Internal patient transfer sweep ---
# Hourly job in .github/workflows/transfers-sweep-cron.yml POSTs to
# /api/patient-transfers/sweep to apply transfers whose clock has run out:
# scheduled transfers reaching their effective date, and temporary/shared-care
# grants reaching their expiry. A scheduled job has no user session, so it
# authenticates with this shared secret. UNSET = no machine access at all.
#   openssl rand -hex 32
#
# WITHOUT this configured, scheduled transfers never take effect on their own
# and expired care-team grants keep their chart access until an administrator
# runs the sweep by hand. Request/accept transfers with no effective date are
# unaffected — those apply the moment they are accepted.
# TRANSFER_SWEEP_SECRET=

# ── Telehealth maintenance sweep (KAN-127/128/143/144) ─────────────────────
# The hourly job in .github/workflows/telehealth-maintenance-cron.yml calls
# POST /api/telehealth/maintenance with this shared secret to expire abandoned
# waiting rooms, mark no-shows, close stuck sessions, and reconcile
# appointment/session divergences. UNSET = no machine access at all.
#   openssl rand -hex 32
#
# WITHOUT this configured, a session left in waiting_room or in_session stays
# there forever and the "active sessions" statistics count ghosts; an
# administrator can still trigger the sweep manually from a signed-in session.
# TELEHEALTH_MAINTENANCE_SECRET=

# --- Product usage analytics (optional PostHog) ---
# First-party usage events always go to CouchDB (tamamhealth_usage_events).
# When NEXT_PUBLIC_POSTHOG_KEY is set, the same sanitized events are also
# forwarded to PostHog. Autocapture is OFF — only our scrubbed events are sent.
# See docs/operations/usage-metrics.md.
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
